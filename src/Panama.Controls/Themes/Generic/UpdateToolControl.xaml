<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:con="clr-namespace:Restless.Panama.Controls">

    <ControlTemplate x:Key="UpdateToolControlTemplate" TargetType="con:UpdateToolControl">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StatusBar Margin="0,0,0,10">
                <TextBlock Text="{TemplateBinding Header}"/>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock Text="{TemplateBinding FolderText}"/>
                </StatusBarItem>
            </StatusBar>

            <!-- Start button / explanation text -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button
                    Height="32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Padding="2"
                    Style="{TemplateBinding ButtonStyle}"
                    Content="{TemplateBinding ButtonContent}"
                    Command="{TemplateBinding ButtonCommand}"/>
                <TextBlock
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    TextWrapping="Wrap"
                    Text="{TemplateBinding ExplanationText}"/>
            </Grid>

            <!-- Mode: Standard -->
            <Grid x:Name="ModeStandard" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{TemplateBinding UpdatedText}" Margin="0,0,0,4"/>
                <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{TemplateBinding UpdatedItemsSource}" Margin="0,0,6,6"/>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="{TemplateBinding NotFoundText}" Margin="0,0,0,4"/>
                <ListBox Grid.Row="1" Grid.Column="1" ItemsSource="{TemplateBinding NotFoundItemsSource}" Margin="0,0,0,6"/>
            </Grid>

            <!-- Mode: Text -->
            <TextBox
                x:Name="OutputText"
                Grid.Row="2"
                AcceptsReturn="True"
                IsReadOnly="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                VerticalAlignment="Stretch"
                Visibility="Collapsed"
                Text="{TemplateBinding OutputText}"/>

            <StatusBar Grid.Row="3">
                <TextBlock Text="{TemplateBinding StatusText}"/>
            </StatusBar>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="Mode" Value="Text">
                <Setter TargetName="OutputText" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ModeStandard" Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </ControlTemplate.Triggers>

    </ControlTemplate>

    <Style TargetType="con:UpdateToolControl">
        <Setter Property="Template" Value="{StaticResource UpdateToolControlTemplate}"/>
    </Style>

</ResourceDictionary>