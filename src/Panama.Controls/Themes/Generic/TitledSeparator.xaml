<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:con="clr-namespace:Restless.Panama.Controls">

    <ControlTemplate x:Key="ControlTemplate.TitledSeparator" TargetType="con:TitledSeparator">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="RightColumn"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Height="{TemplateBinding SeparatorHeight}"/>

            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                Margin="4,0"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Text="{TemplateBinding Title}"/>

            <Border
                Grid.Column="2"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Height="{TemplateBinding SeparatorHeight}"/>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="HorizontalContentAlignment" Value="Left">
                <Setter TargetName="LeftColumn" Property="Width" Value="14"/>
            </Trigger>
            <Trigger Property="HorizontalContentAlignment" Value="Right">
                <Setter TargetName="RightColumn" Property="Width" Value="14"/>
            </Trigger>
            <Trigger Property="DisplayTitle" Value="False">
                <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </ControlTemplate.Triggers>

    </ControlTemplate>

    <Style TargetType="con:TitledSeparator">
        <Setter Property="Background" Value="LightGray"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource ControlTemplate.TitledSeparator}"/>
    </Style>

</ResourceDictionary>