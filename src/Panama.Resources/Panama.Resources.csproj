<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Panama.Resources</AssemblyName>
    <Authors>Restless Animal Development</Authors>
    <Company>Restless Animal Development</Company>
    <Copyright>(c) 2020-2024 Restless Animal Development</Copyright>
    <Description>Provides resources for the Panama application.</Description>
    <OutputType>Library</OutputType>
    <PackageId>Panama.Resources</PackageId>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/victor-david/panama</PackageProjectUrl>
    <PackageReleaseNotes></PackageReleaseNotes>
    <PackageTags>resources</PackageTags>
    <Product>Panama Resources</Product>
    <RepositoryUrl>https://github.com/victor-david/panama</RepositoryUrl>
    <RootNamespace>Restless.Panama.Resources</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Title>Panama Resources</Title>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>