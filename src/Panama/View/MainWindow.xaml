<mah:MetroWindow
    x:Class="Restless.Panama.View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:core="clr-namespace:Restless.Panama.Core"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    d:DesignHeight="300" d:DesignWidth="610"
    mc:Ignorable="d"
    Style="{StaticResource App.Styles.MetroWindow}"
    Title="{Binding Path=DisplayName, Mode=OneTime}"
    WindowStartupLocation="CenterScreen">

    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands Margin="16,0" ShowSeparators="False">

            <mah:WindowCommands.Resources>
                <Style TargetType="ico:PackIconMaterial" BasedOn="{StaticResource App.Styles.Icon.TitleBar}"/>
            </mah:WindowCommands.Resources>

            <Button
                Command="{Binding SaveAllCommand}"
                ToolTip="{x:Static r:ToolTip.SaveAll}">
                <ico:PackIconMaterial Kind="ContentSaveAllOutline"/>
            </Button>

            <Button
                Command="{Binding OpenSettingsCommand}"
                ToolTip="{x:Static r:ToolTip.OpenWindowSettings}">
                <ico:PackIconMaterial Kind="CogOutline"/>
            </Button>

            <Button
                Command="{Binding ResetWindowCommand}"
                ToolTip="{x:Static r:ToolTip.ResetWindow}">
                <ico:Material Kind="Monitor"/>
            </Button>

            <Button
                Command="{Binding OpenToolsCommand}"
                ToolTip="{x:Static r:ToolTip.OpenWindowTool}">
                <ico:Material Kind="Tools"/>
            </Button>

            <Button
                Command="{Binding OpenAboutCommand}"
                ToolTip="{x:Static r:ToolTip.OpenWindowAbout}">
                <ico:PackIconMaterial Kind="InformationVariant"/>
            </Button>


        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>

    <Grid tk:Property.RowHeights="*,Auto">
        <tk:MultiSplitterGrid
            Style="{StaticResource App.Styles.MainSplitter}"
            MinDetailSize="{x:Static core:Config+MainNavigation.MinWidth}"
            MaxDetailSize="{x:Static core:Config+MainNavigation.MaxWidth}"
            DetailSize="{Binding Config.MainNavigationWidth , Mode=TwoWay}">

            <tk:MultiSplitterGrid.DetailContent>
                <Grid tk:Property.RowHeights="Auto,*">
                    <TextBlock Style="{StaticResource App.Styles.TextBlock.NavTitle}" Text="{Binding AppInfo.Product, Mode=OneTime}"/>

                    <ListBox
                        Grid.Row="1"
                        Style="{StaticResource App.Styles.ListBox.Navigator}"
                        ItemsSource="{Binding NavigatorItems}"
                        SelectedItem="{Binding SelectedNavigatorItem}"/>

                </Grid>
            </tk:MultiSplitterGrid.DetailContent>

            <tk:MultiSplitterGrid.MainContent>
                <ContentControl Content="{Binding SelectedViewModel}"/>
            </tk:MultiSplitterGrid.MainContent>

        </tk:MultiSplitterGrid>

        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <TextBlock
                    Style="{StaticResource App.Styles.TextBlock.NotificationMessage}"
                    Text="{Binding NotificationMessage, NotifyOnTargetUpdated=True}"/>
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding DisplayName, Mode=OneTime}"/>
            </StatusBarItem>

        </StatusBar>
    </Grid>

</mah:MetroWindow>