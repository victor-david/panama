<Grid
    x:Class="Restless.Panama.View.PublisherEditMain"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel" d:DataContext="{d:DesignInstance Type=vm:PublisherViewModel}"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="400"
    Style="{StaticResource Panama.Styles.Panel.DataEntry}"
    tk:Property.RowHeights="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">

    <TextBlock Grid.Row="0" Text="{x:Static r:Text.Name}"/>
    <TextBox Grid.Row="1" Text="{Binding SelectedPublisher.Name}"/>

    <TextBlock Grid.Row="2" Text="{x:Static r:Text.Url}"/>
    <TextBox Grid.Row="3" Text="{Binding SelectedPublisher.Url}"/>

    <TextBlock Grid.Row="4" Text="{x:Static r:Text.Email}"/>
    <TextBox Grid.Row="5" Text="{Binding SelectedPublisher.Email}"/>

    <CheckBox Grid.Row="6" Content="{x:Static r:Text.ExclusiveNoSim}" IsChecked="{Binding SelectedPublisher.Exclusive}"/>
    <CheckBox Grid.Row="7" Content="{x:Static r:Text.Paying}" IsChecked="{Binding SelectedPublisher.Paying}"/>
    <CheckBox Grid.Row="8" Content="{x:Static r:Text.FollowUp}" IsChecked="{Binding SelectedPublisher.FollowUp}"/>
    <CheckBox Grid.Row="9" Content="{x:Static r:Text.Goner}" IsChecked="{Binding SelectedPublisher.Goner}"/>

    <TextBlock Grid.Row="10" Text="{x:Static r:Text.Notes}"/>
    <TextBox
        Grid.Row="11"
        Style="{StaticResource Panama.Styles.TextBox.Multiline}"
        Text="{Binding SelectedPublisher.Notes}"/>

</Grid>