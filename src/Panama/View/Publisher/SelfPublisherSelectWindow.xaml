<mah:MetroWindow
    x:Class="Restless.Panama.View.SelfPublisherSelectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:SelfPublisherSelectWindowViewModel}"
    mc:Ignorable="d"
    ResizeMode="NoResize"
    Title="{x:Static r:Strings.WindowTitleSelectPublisherGeneric}"
    Style="{StaticResource Panama.Styles.MetroWindow}"
    Height="680" Width="568">

    <Grid tk:Property.RowHeights="Auto,*">

        <StatusBar Style="{StaticResource Panama.Styles.StatusBar.Selector}">
            <TextBlock Text="{x:Static r:Strings.TextPublisher}"/>
            <TextBox Width="100" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
            <Separator/>
            <Button Content="Select" Command="{Binding Commands[Select]}"/>
        </StatusBar>

        <tk:DataGrid
            Grid.Row="1"
            BorderThickness="0,1,0,0"
            ItemsSource="{Binding ListView}"
            SelectedItem="{Binding SelectedItem}"
            tk:DataGridColumns.Columns="{Binding Columns}"/>
    </Grid>

</mah:MetroWindow>