<Grid
    x:Class="Restless.Panama.View.PublisherFilter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:PublisherViewModel}"
    mc:Ignorable="d"
    Style="{StaticResource App.Styles.Panel.DataEntry}"
    tk:Property.ColumnWidths="*,*"
    tk:Property.RowHeights="Auto,*"
    d:DesignHeight="450" d:DesignWidth="800">

    <StackPanel Grid.ColumnSpan="2">
        <TextBlock Text="{x:Static r:Text.Name}"/>
        <TextBox
            Text="{Binding Filters.Text,
            UpdateSourceTrigger=PropertyChanged,
            Delay=500}"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.Column="0">
        <tk:ThreeWay Header="{x:Static r:Text.Active}" State="{Binding Filters.ActiveState}"/>
        <tk:ThreeWay Header="{x:Static r:Text.OpenSubmission}" State="{Binding Filters.OpenState}"/>
        <tk:ThreeWay Header="{x:Static r:Text.InPeriod}" State="{Binding Filters.InPeriodState}"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.Column="1">
        <tk:ThreeWay Header="{x:Static r:Text.Exclusive}" State="{Binding Filters.ExclusiveState}"/>
        <tk:ThreeWay Header="{x:Static r:Text.FollowUp}" State="{Binding Filters.FollowUpState}"/>
        <tk:ThreeWay Header="{x:Static r:Text.Paying}" State="{Binding Filters.PayingState}"/>
        <tk:ThreeWay Header="{x:Static r:Text.Goner}" State="{Binding Filters.GonerState}"/>
    </StackPanel>

</Grid>