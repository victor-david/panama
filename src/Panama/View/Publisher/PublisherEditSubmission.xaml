<Grid
    x:Class="Restless.Panama.View.PublisherEditSubmission"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:PublisherViewModel}"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="400"
    Style="{StaticResource App.Styles.Panel.DataEntry}"
    tk:Property.RowHeights="Auto,*,Auto,2*">

    <!-- Submissions -->
    <TextBlock Text="{x:Static r:Header.Submissions}"/>

    <tk:DataGrid
        Grid.Row="1"
        Style="{StaticResource App.Styles.DataGrid.Locked}"
        Margin="{DynamicResource Panama.Layout.Margin.Control.Stacked}"
        ItemsSource="{Binding Submissions.ListView}"
        SelectedItem="{Binding Submissions.SelectedItem}"
        tk:DataGridColumns.Columns="{Binding Submissions.Columns}"/>

    <TextBlock
        Grid.Row="1"
        Style="{StaticResource App.Styles.TextBlock.ZeroResult}"
        tk:Property.IsCollapsed="{Binding Submissions.HaveItems}"
        Text="{x:Static r:Text.NoPublisherSubmissions}"/>

    <!-- Submission titles -->
    <TextBlock Grid.Row="2" Text="{x:Static r:Header.Titles}"/>

    <tk:DataGrid
        Grid.Row="3"
        Style="{StaticResource App.Styles.DataGrid.Locked}"
        Margin="{DynamicResource Panama.Layout.Margin.Control.Stacked}"
        ItemsSource="{Binding Submissions.Titles.ListView}"
        SelectedItem="{Binding Submissions.Titles.SelectedItem}"
        tk:DataGridColumns.Columns="{Binding Submissions.Titles.Columns}">

        <DataGrid.ContextMenu>
            <ContextMenu ItemsSource="{Binding Submissions.Titles.MenuItems}"  />
        </DataGrid.ContextMenu>

        <DataGrid.InputBindings>
            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding Submissions.Titles.OpenRowCommand}"/>
        </DataGrid.InputBindings>

    </tk:DataGrid>

    <TextBlock
        Grid.Row="3"
        Style="{StaticResource App.Styles.TextBlock.ZeroResult}"
        tk:Property.IsCollapsed="{Binding Submissions.Titles.HaveItems}"
        Text="{x:Static r:Text.NoTitles}"/>

</Grid>
