<mah:MetroWindow
    x:Class="Restless.Panama.View.StartupToolWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:StartupToolWindowViewModel}"
    mc:Ignorable="d"
    ResizeMode="NoResize"
    SizeToContent="Height"
    Title="{Binding DisplayName, Mode=OneTime}"
    Style="{StaticResource App.Styles.MetroWindow}"
    d:DesignHeight="260" d:DesignWidth="480">

    <Grid tk:Property.RowHeights="*,*,*,*,Auto" tk:Property.ColumnWidths="*" Margin="{StaticResource App.Layout.Padding.Full}">

        <Grid.Resources>
            <Style TargetType="Grid">
                <Setter Property="tk:Property.ColumnWidths" Value="48,*"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style TargetType="tk:WaitPanel">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="16,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="App.Styles.TextBlock.Closing" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,6"/>
            </Style>

            <Style TargetType="ico:PackIconMaterial" BasedOn="{StaticResource App.Styles.Icon}">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
            </Style>
        </Grid.Resources>

        <Grid Grid.Row="0" tk:Property.IsVisible="{Binding RequestedOps[0]}">
            <tk:WaitPanel tk:Property.IsVisible="{Binding InProgressOps[0]}"/>
            <ico:PackIconMaterial Kind="CheckboxMarkedOutline" tk:Property.IsVisible="{Binding CompletedOps[0]}"/>
            <TextBlock Grid.Column="1" Text="Updating title metadata"/>
        </Grid>

        <Grid Grid.Row="1" tk:Property.IsVisible="{Binding RequestedOps[1]}">
            <tk:WaitPanel tk:Property.IsVisible="{Binding InProgressOps[1]}"/>
            <ico:PackIconMaterial Kind="CheckboxMarkedOutline" tk:Property.IsVisible="{Binding CompletedOps[1]}"/>
            <TextBlock Grid.Column="1" Text="Updating submission metadata"/>
        </Grid>

        <Grid Grid.Row="2" tk:Property.IsVisible="{Binding RequestedOps[2]}">
            <tk:WaitPanel tk:Property.IsVisible="{Binding InProgressOps[2]}"/>
            <ico:PackIconMaterial Kind="CheckboxMarkedOutline" tk:Property.IsVisible="{Binding CompletedOps[2]}"/>
            <TextBlock Grid.Column="1" Text="Exporting title documents"/>
        </Grid>

        <Grid Grid.Row="3" tk:Property.IsVisible="{Binding RequestedOps[3]}">
            <tk:WaitPanel tk:Property.IsVisible="{Binding InProgressOps[3]}"/>
            <ico:PackIconMaterial Kind="CheckboxMarkedOutline" tk:Property.IsVisible="{Binding CompletedOps[3]}"/>
            <TextBlock Grid.Column="1" Text="Creating title list"/>
        </Grid>

        <TextBlock Grid.Row="4" Style="{StaticResource App.Styles.TextBlock.Closing}" tk:Property.IsVisible="{Binding IsCompleted}">
            <Run Text="Closing in"/>
            <Run Style="{StaticResource App.Styles.Run.Highlight}" Text="{Binding SecondsToClose, Mode=OneWay}"/>
            <Run Text="seconds"/>
        </TextBlock>

    </Grid>
</mah:MetroWindow>