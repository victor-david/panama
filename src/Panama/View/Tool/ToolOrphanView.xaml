<UserControl
    x:Class="Restless.Panama.View.ToolOrphanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:core="clr-namespace:Restless.Panama.Core"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:con="clr-namespace:Restless.Panama.Controls;assembly=Panama.Controls"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    xmlns:vw="clr-namespace:Restless.Panama.View"
    d:DataContext="{d:DesignInstance Type=vm:ToolOrphanViewModel}"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">

    <tk:SplitterGrid
        MinDetailWidth="{x:Static core:Config+Grid.MinOrphanDetailWidth}"
        MaxDetailWidth="{x:Static core:Config+Grid.MaxOrphanDetailWidth}"
        IsDetailExpanded="{Binding Config.OrphanDetailExpanded}"
        DetailWidth="{Binding Config.OrphanDetailWidth}">

        <tk:SplitterGrid.HeaderLeft>
            <StatusBar>
                <StatusBarItem DockPanel.Dock="Right">
                    <TextBlock>
                    <Run
                        Style="{StaticResource App.Styles.Run.Highlight}"
                        Text="{Binding ListView.Count, Mode=OneWay}"/>
                    <Run Text="{x:Static r:Text.Orphans}"/>
                    </TextBlock>
                </StatusBarItem>

                <StatusBarItem DockPanel.Dock="Right" Margin="0,0,50,0">
                    <Button
                        Style="{StaticResource MahApps.Styles.Button.Reveal}"
                        Command="{Binding ToggleCustomFilterCommand}"
                        ToolTip="{x:Static r:ToolTip.OrphanExclusions}">

                        <ico:PackIconMaterial Kind="CogOutline"/>

                    </Button>
                </StatusBarItem>

                <TextBlock Text="{x:Static r:Header.Orphan}"/>
                <Button Content="{x:Static r:Text.Start}" Command="{Binding StartScanCommand}"/>
            </StatusBar>
        </tk:SplitterGrid.HeaderLeft>

        <tk:SplitterGrid.HeaderRight>
            <StatusBar>
                <TextBlock Text="{Binding SelectedOrphan.FileName}"/>

            </StatusBar>
        </tk:SplitterGrid.HeaderRight>

        <tk:SplitterGrid.ContentLeft>
            <Grid>
                <DataGrid
                    ItemsSource="{Binding Path=ListView}"
                    SelectedItem="{Binding SelectedItem}"
                    tk:DataGridColumns.Columns="{Binding Columns}">

                    <DataGrid.ContextMenu>
                        <ContextMenu ItemsSource="{Binding MenuItems}"/>
                    </DataGrid.ContextMenu>

                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenRowCommand}"/>
                    </DataGrid.InputBindings>

                </DataGrid>

                <tk:Flyout Placement="Right" Width="530" IsOpen="{Binding IsCustomFilterOpen}">

                    <tk:Flyout.Header>
                        <vw:FlyoutHeader Title="{x:Static r:Header.Exclusions}" ShowClearButton="False"/>
                    </tk:Flyout.Header>

                    <DataGrid
                        ItemsSource="{Binding Exclusions.ListView}"
                        SelectedItem="{Binding Exclusions.SelectedItem}"
                        RowHeight="{x:Static core:Config+DataGrid.MinRowHeight}"
                        tk:DataGridColumns.Columns="{Binding Exclusions.Columns}">

                        <DataGrid.ContextMenu>
                            <ContextMenu ItemsSource="{Binding Exclusions.MenuItems}"/>
                        </DataGrid.ContextMenu>

                    </DataGrid>

                </tk:Flyout>

                <tk:WaitSpinner Height="64" tk:Property.IsVisible="{Binding IsOperationInProgress}"/>

            </Grid>
        </tk:SplitterGrid.ContentLeft>

        <tk:SplitterGrid.ContentRight>
            <Grid
                tk:Property.RowHeights="Auto,Auto,*"
                tk:Property.ColumnWidths="Auto,*"
                Style="{StaticResource App.Styles.Panel.DataEntry}"
                Visibility="{Binding EditVisibility}">

                <TextBlock
                    Grid.Row="0" Grid.Column="0"
                    Margin="{StaticResource App.Layout.Padding.Right}"
                    Style="{StaticResource App.Styles.TextBlock.Highlight}"
                    Text="{x:Static r:Header.Size}"/>

                <TextBlock
                    Grid.Row="0" Grid.Column="1"
                    Text="{Binding SelectedOrphan.Size,StringFormat=N0}"/>

                <TextBlock
                    Grid.Row="1" Grid.Column="0"
                    Margin="{StaticResource App.Layout.Padding.Right}"
                    Style="{StaticResource App.Styles.TextBlock.Highlight}"
                    Text="{x:Static r:Header.Updated}"/>

                <TextBlock
                    Grid.Row="1" Grid.Column="1"
                    Text="{Binding SelectedOrphan.LastWriteTimeUtc,StringFormat='MMMM, dd, yyyy HHH:MM'}"/>

                <vw:PreviewPanel
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    HeaderVisibility="Collapsed"
                    PreviewMode="{Binding PreviewMode}"
                    PreviewText="{Binding PreviewText}"
                    PreviewImageSource="{Binding PreviewImageSource}"/>
            </Grid>
        </tk:SplitterGrid.ContentRight>

    </tk:SplitterGrid>

</UserControl>
