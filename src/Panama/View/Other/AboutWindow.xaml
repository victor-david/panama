<mah:MetroWindow
    x:Class="Restless.Panama.View.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:AboutWindowViewModel}"
    mc:Ignorable="d"
    ResizeMode="NoResize"
    Title="{Binding DisplayName, Mode=OneTime}"
    Style="{StaticResource App.Styles.MetroWindow}"
    Width="440"
    SizeToContent="Height"
    ShowInTaskbar="False">

    <StackPanel Margin="{StaticResource Panama.Layout.Padding.Full}">

        <StackPanel.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Foreground" Value="{StaticResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </StackPanel.Resources>

        <Grid tk:Property.ColumnWidths="Auto,10,*">
            <TextBlock
                Margin="0"
                VerticalAlignment="Center"
                Style="{StaticResource App.Styles.TextBlock.NavTitle}"
                Text="{Binding AppInfo.Title, Mode=OneTime}"/>

            <TextBlock Grid.Column="2" Margin="0" HorizontalAlignment="Right">
                <Run Text="Version"/>
                <Run
                    Style="{StaticResource App.Styles.Run.Highlight}"
                    Text="{Binding AppInfo.VersionMajor, Mode=OneTime}"/>
                <Run Text="Build"/>
                <Run
                    Style="{StaticResource App.Styles.Run.Highlight}"
                    Text="{Binding AppInfo.VersionRaw.Build, Mode=OneTime}"/>
            </TextBlock>
        </Grid>

        <Separator Margin="0,6"/>

        <TextBlock Text="{Binding AppInfo.Description, Mode=OneTime}"/>
        <TextBlock Text="{Binding AppInfo.Company, Mode=OneTime}"/>
        <TextBlock Text="{Binding AppInfo.Copyright, Mode=OneTime}"/>
        <TextBlock Text="{Binding AppInfo.Framework, Mode=OneTime}"/>
        <TextBlock>
            <Run Text="{x:Static r:Settings.DatabaseLocation}"/>
            <Run
                Style="{StaticResource App.Styles.Run.Highlight}"
                Text="{Binding DatabaseLocation, Mode=OneTime}"/>
        </TextBlock>
        <TextBlock>
            <Run Text="{x:Static r:Text.Startup}"/>
            <Run
                Style="{StaticResource App.Styles.Run.Highlight}"
                Text="{Binding Config.StartupCount, Mode=OneTime, StringFormat='{}{0:#,0}'}"/>
        </TextBlock>

    </StackPanel>
</mah:MetroWindow>