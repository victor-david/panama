<mah:MetroWindow
    x:Class="Restless.Panama.View.AlertWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:AlertWindowViewModel}"
    mc:Ignorable="d"
    ResizeMode="NoResize"
    Title="{Binding DisplayName, Mode=OneTime}"
    Style="{StaticResource App.Styles.MetroWindow}"
    Height="360" Width="584" >

    <Grid
        tk:Property.RowHeights="*,Auto">

        <tk:DataGrid
            BorderThickness="0,0,0,1"
            ItemsSource="{Binding ListView}"
            SelectedItem="{Binding SelectedItem}"
            tk:DataGridColumns.Columns="{Binding Columns}">

            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenRowCommand}"/>
            </DataGrid.InputBindings>

            <DataGrid.ContextMenu>
                <ContextMenu ItemsSource="{Binding MenuItems}"/>
            </DataGrid.ContextMenu>

        </tk:DataGrid>

        <StatusBar Grid.Row="1">
            <TextBlock Text="{x:Static r:Text.Postpone}"/>
            <Button
                Content="{x:Static r:Text.Days01}"
                Command="{Binding PostponeCommand}"
                CommandParameter="1"/>

            <Button
                Content="{x:Static r:Text.Days03}"
                Command="{Binding PostponeCommand}"
                CommandParameter="3"/>

            <Button
                Content="{x:Static r:Text.Days05}"
                Command="{Binding PostponeCommand}"
                CommandParameter="5"/>

            <Button
                Content="{x:Static r:Text.Days07}"
                Command="{Binding PostponeCommand}"
                CommandParameter="7"/>

            <Button
                Content="{x:Static r:Text.Days10}"
                Command="{Binding PostponeCommand}"
                CommandParameter="10"/>

            <Separator/>

            <Button
                Content="{x:Static r:Text.Dismiss}"
                Command="{Binding DismissCommand}"/>

        </StatusBar>

    </Grid>
</mah:MetroWindow>