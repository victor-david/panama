<mah:MetroWindow
    x:Class="Restless.Panama.View.TerminateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:TerminateWindowViewModel}"
    mc:Ignorable="d"
    ResizeMode="NoResize"
    SizeToContent="Height"
    Width="472"
    Title="{x:Static r:Strings.WindowTitleFatalError}"
    Style="{StaticResource Panama.Styles.MetroWindow}">

    <Grid tk:Property.RowHeights="*,Auto">

        <TextBlock
            Style="{StaticResource Panama.Styles.TextBlock.Highlight}"
            Margin="{StaticResource Panama.Layout.Padding.Full}"
            VerticalAlignment="Top"
            FontSize="12"
            Text="{Binding Message, FallbackValue=Error}"/>

        <StatusBar Grid.Row="1">

            <StatusBarItem DockPanel.Dock="Right" tk:Property.IsVisible="{Binding IsSendCommandEnabled}">
                <Button
                    Content="{x:Static r:Strings.TextSendReport}"
                    ToolTip="{x:Static r:Strings.ToolTipSendReport}"
                    Command="{Binding SendCommand}"/>
            </StatusBarItem>

            <TextBlock Text="{x:Static r:Strings.WindowTitleFatalError}"/>

        </StatusBar>

    </Grid>
</mah:MetroWindow>