<Grid
    x:Class="Restless.Panama.View.TitleEditPublished"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:TitleViewModel}"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="360"
    tk:Property.RowHeights="Auto,*">

    <Grid.Resources>
        <Style TargetType="tk:RadioButton" BasedOn="{StaticResource App.Styles.RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent2}"/>
        </Style>
        <Style TargetType="tk:DataGrid" BasedOn="{StaticResource App.Styles.DataGrid}">
            <Setter Property="Margin" Value="{DynamicResource App.Layout.Margin.Control.Stacked}"/>
        </Style>
    </Grid.Resources>

    <tk:RadioButtonPanel
        Margin="{DynamicResource App.Layout.Padding.Bottom}"
        tk:Property.ColumnWidths="Auto,Auto"
        SelectedValue="{Binding SelectedPublishedEditSection}">

        <tk:RadioButton Grid.Column="0" Value="1" Content="{x:Static r:Text.Published}"/>
        <tk:RadioButton Grid.Column="1" Value="2" Content="{x:Static r:Text.SelfPublished}"/>
    </tk:RadioButtonPanel>

    <!-- Published -->
    <Grid
        Grid.Row="1"
        tk:Property.RowHeights="*,2*"
        tk:Property.IsLongVisible="{Binding SelectedPublishedEditSection}"
        tk:Property.IsLongVisibleValue="1">

        <!-- List -->
        <tk:DataGrid
            ItemsSource="{Binding Published.ListView}"
            SelectedItem="{Binding Published.SelectedItem}"
            tk:DataGridColumns.Columns="{Binding Published.Columns}">

            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding Published.OpenRowCommand}"/>
            </DataGrid.InputBindings>

            <DataGrid.ContextMenu>
                <ContextMenu ItemsSource="{Binding Published.MenuItems}"/>
            </DataGrid.ContextMenu>

        </tk:DataGrid>

        <!-- Edit selected item -->
        <StackPanel
            Grid.Row="1"
            Style="{StaticResource App.Styles.Panel.DataEntry}"
            Visibility="{Binding Published.EditVisibility}">

            <TextBlock Text="{x:Static r:Text.Published}"/>
            <DatePicker SelectedDate="{Binding Published.PublishedDate}"/>

            <TextBlock Text="{x:Static r:Text.Url}"/>
            <TextBox Text="{Binding Published.SelectedPublished.Url}"/>

            <TextBlock Text="{x:Static r:Text.Notes}"/>
            <TextBox
                Style="{StaticResource App.Styles.TextBox.Multiline}"
                MinHeight="112"
                Text="{Binding Published.SelectedPublished.Notes}"/>

            <CheckBox Content="{x:Static r:Text.Active}" IsChecked="{Binding Published.SelectedPublished.Active}"/>
        </StackPanel>
    </Grid>

    <!-- Self Published -->
    <Grid
        Grid.Row="1"
        tk:Property.RowHeights="*,2*"
        tk:Property.IsLongVisible="{Binding SelectedPublishedEditSection}"
        tk:Property.IsLongVisibleValue="2">

        <!-- List -->
        <tk:DataGrid
            ItemsSource="{Binding SelfPublished.ListView}"
            SelectedItem="{Binding SelfPublished.SelectedItem}"
            tk:DataGridColumns.Columns="{Binding SelfPublished.Columns}">

            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding SelfPublished.OpenRowCommand}"/>
            </DataGrid.InputBindings>

            <DataGrid.ContextMenu>
                <ContextMenu ItemsSource="{Binding SelfPublished.MenuItems}"/>
            </DataGrid.ContextMenu>
        </tk:DataGrid>

        <!-- Edit selected item -->
        <StackPanel
            Grid.Row="1"
            Style="{StaticResource App.Styles.Panel.DataEntry}"
            Visibility="{Binding SelfPublished.EditVisibility}">

            <TextBlock Text="{x:Static r:Text.Published}"/>
            <DatePicker SelectedDate="{Binding SelfPublished.PublishedDate}"/>

            <TextBlock Text="{x:Static r:Text.Url}"/>
            <TextBox Text="{Binding SelfPublished.SelectedPublished.Url}"/>

            <TextBlock Text="{x:Static r:Text.Note}"/>
            <TextBox
                Style="{StaticResource App.Styles.TextBox.Multiline}"
                MinHeight="112"
                Text="{Binding SelfPublished.SelectedPublished.Notes}"/>

            <CheckBox Content="{x:Static r:Text.Active}" IsChecked="{Binding SelfPublished.SelectedPublished.Active}"/>
        </StackPanel>
    </Grid>
</Grid>