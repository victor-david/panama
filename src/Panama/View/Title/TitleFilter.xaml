<Grid
    x:Class="Restless.Panama.View.TitleFilter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:conl="clr-namespace:Restless.Panama.Controls;assembly=Panama.Controls"
    xmlns:core="clr-namespace:Restless.Panama.Core"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:TitleViewModel}"
    mc:Ignorable="d"
    Style="{StaticResource App.Styles.Panel.DataEntry}"
    tk:Property.ColumnWidths="*,*,*"
    tk:Property.RowHeights="Auto,Auto,Auto,*"
    d:DesignHeight="450" d:DesignWidth="592">

    <!-- Title -->
    <StackPanel Margin="{StaticResource App.Layout.Margin.Control.Stacked.Right}">
        <TextBlock Text="{x:Static r:Text.Title}"/>
        <TextBox
            Text="{Binding Filters.Text,
            UpdateSourceTrigger=PropertyChanged,
            Delay=500}"/>
    </StackPanel>

    <!-- Title note -->
    <StackPanel Grid.Column="1" Margin="{StaticResource App.Layout.Margin.Control.Stacked.Right}">
        <TextBlock Text="{x:Static r:Text.Note}"/>
        <TextBox
            Text="{Binding Filters.Note,
            UpdateSourceTrigger=PropertyChanged,
            Delay=500}"/>
    </StackPanel>

    <!-- Directory -->
    <StackPanel Grid.Column="2">
        <TextBlock Text="{x:Static r:Text.Path}"/>
        <TextBox
            Text="{Binding Filters.Directory,
            UpdateSourceTrigger=PropertyChanged,
            Delay=500}"/>
    </StackPanel>

    <!-- Three way flags -->
    <StackPanel Grid.Row="1" Grid.Column="0" Margin="{DynamicResource App.Layout.Margin.Control.Stacked}">
        <tk:ThreeWay Header="{x:Static r:Text.Ready}" State="{Binding Filters.ReadyState}"/>
        <tk:ThreeWay Header="{x:Static r:Text.Submitted}" State="{Binding Filters.CurrentlySubmittedState}"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.Column="1" Margin="{DynamicResource App.Layout.Margin.Control.Stacked}">
        <tk:ThreeWay Header="{x:Static r:Text.Flagged}" State="{Binding Filters.FlaggedState}"/>
        <tk:ThreeWay Header="{x:Static r:Text.EverSubmitted}" State="{Binding Filters.EverSubmittedState}"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.Column="2">
        <tk:ThreeWay Header="{x:Static r:Text.HasRelated}" State="{Binding Filters.RelatedState}"/>
        <tk:ThreeWay Header="{x:Static r:Text.Published}" State="{Binding Filters.PublishedState}"/>
    </StackPanel>

    <!-- Word count -->
    <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
        <TextBlock>
            <Run Text="{x:Static r:Text.WordCount}"/>
            <Run
                Style="{StaticResource App.Styles.Run.Highlight}"
                Text="{Binding Filters.WordCountText, Mode=OneWay}"/>
        </TextBlock>

        <Slider
            Minimum="{x:Static core:Config+Other.MinFilterWordCount}"
            Maximum="{x:Static core:Config+Other.MaxFilterWordCount}"
            TickFrequency="100"
            Value="{Binding Filters.WordCount, Mode=TwoWay, Delay=500}"/>
    </StackPanel>

    <!-- Tags -->
    <Grid
        Grid.Row="3" Grid.ColumnSpan="3"
        tk:Property.RowHeights="Auto,*,Auto,Auto"
        tk:Property.ColumnWidths="*,5,*">

        <!-- Tags (assigned) -->
        <conl:TitledSeparator Title="{x:Static r:Text.AssignedToFilter}"/>

        <conl:TagSelectorControl
            Grid.Row="1"
            Id="{x:Static vm:TitleTagController.AssignedSelectorId}"
            TagItemClickedCommand="{Binding FilterTags.TagItemClickCommand}"
            ItemsSource="{Binding FilterTags.Assigned}"/>

        <TextBlock
            Grid.Row="1"
            tk:Property.IsCollapsed="{Binding FilterTags.HasAssignedTags}"
            Margin="0,6"
            VerticalAlignment="Top"
            Text="{x:Static r:Text.None}"/>

        <!-- Tags (available) -->
         <conl:TitledSeparator Grid.Column="2" Title="{x:Static r:Text.AvailableTags}"/>

        <conl:TagSelectorControl
            Grid.Row="1" Grid.Column="2"
            Id="{x:Static vm:TitleTagController.AvailableSelectorId}"
            TagItemClickedCommand="{Binding FilterTags.TagItemClickCommand}"
            ItemsSource="{Binding FilterTags.Available}"/>

        <!-- Tags (how to combine) -->
        <conl:TitledSeparator
            Grid.Row="2" Grid.ColumnSpan="3"
            HorizontalContentAlignment="Left"
            Title="{x:Static r:Text.MultipleTag}"/>

        <!-- Style="{StaticResource ToolStatusBarStyle}" -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal">
            <CheckBox Content="{x:Static r:Text.Any}" Margin="5,0" IsChecked="{Binding Filters.IsTagFilterAny}"/>
            <CheckBox Content="{x:Static r:Text.All}" Margin="5,0" IsChecked="{Binding Filters.IsTagFilterAll}"/>
        </StackPanel>
    </Grid>

</Grid>