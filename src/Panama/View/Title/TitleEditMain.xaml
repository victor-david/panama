<Grid
    x:Class="Restless.Panama.View.TitleEditMain"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:TitleViewModel}"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="400"
    Style="{StaticResource Panama.Styles.Panel.DataEntry}"
    tk:Property.RowHeights="Auto,Auto,Auto,Auto,Auto,*" >

    <!-- Title -->
    <Grid tk:Property.ColumnWidths="*,*" tk:Property.RowHeights="Auto,Auto">
        <TextBlock Text="{x:Static r:Text.Title}"/>
        <tk:LinkedTextBlock
            Grid.Column="1"
            Text="{x:Static r:Text.Extract}"
            ToolTip="{x:Static r:ToolTip.Extract}"
            Command="{Binding Commands[ExtractTitle]}"/>

        <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SelectedTitle.Title}"/>
    </Grid>

    <!-- Ready -->
    <CheckBox
        Grid.Row="1"
        Content="{x:Static r:Text.Ready}"
        IsChecked="{Binding SelectedTitle.Ready}"/>

    <!-- Written date -->
    <TextBlock Grid.Row="2" Text="{x:Static r:Text.Written}"/>
    <DatePicker
        Grid.Row="3"
        SelectedDate="{Binding SelectedTitle.Written}"/>

    <!-- Title notes -->
    <TextBlock Grid.Row="4" Text="{x:Static r:Text.Notes}"/>
    <TextBox
        Grid.Row="5"
        Style="{StaticResource Panama.Styles.TextBox.Multiline}"
        Text="{Binding SelectedTitle.Notes}"/>

</Grid>