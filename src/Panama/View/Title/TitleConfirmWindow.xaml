<mah:MetroWindow
    x:Class="Restless.Panama.View.TitleConfirmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:TitleSelectWindowViewModel}"
    mc:Ignorable="d"
    ResizeMode="NoResize"
    Title="{x:Static r:Header.ConfirmTitleSubmission}"
    Style="{StaticResource Panama.Styles.MetroWindow}"
    Height="370" Width="760">

    <Grid tk:Property.RowHeights="*,Auto">
        <!-- RowStyle="{StaticResource TitleConfirmDataGridRowStyle}" -->
        <tk:DataGrid
            Style="{StaticResource Panama.Styles.DataGrid.Locked}"
            BorderThickness="0,0,0,1"
            ItemsSource="{Binding ListView}"
            SelectedItem="{Binding SelectedItem}"
            tk:DataGridColumns.Columns="{Binding Columns}"/>

        <StackPanel
            Grid.Row="1"
            Margin="{StaticResource Panama.Layout.Padding.Vertical}"
            Orientation="Horizontal"
            HorizontalAlignment="Center">

            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource Panama.Styles.Button.Dialog}"/>
            </StackPanel.Resources>

            <Button
                Content="{x:Static r:Strings.TextConfirm}"
                Command="{Binding Commands[Confirm]}"/>

            <Button
                Content="{x:Static r:Strings.TextCancel}"
                Command="{Binding CloseWindowCommand}"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>