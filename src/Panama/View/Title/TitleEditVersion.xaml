<Grid
    x:Class="Restless.Panama.View.TitleEditVersion"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:TitleViewModel}"
    mc:Ignorable="d"
    Style="{StaticResource Panama.Styles.Panel.DataEntry}"
    tk:Property.RowHeights="*,Auto,2*"
    d:DesignHeight="650" d:DesignWidth="400">

    <!-- Version list and its controls (move up, move down, sync file names) -->
    <Grid
        tk:Property.ColumnWidths="Auto,*"
        Margin="{DynamicResource Panama.Layout.Margin.Control.Stacked}">

        <StackPanel
            Margin="{DynamicResource Panama.Layout.Padding.Right.Tight}"
            Style="{StaticResource Panama.Styles.StackPanel.ToolBar.Vertical}">

            <Button
                Margin="0,30,0,0"
                Content="{StaticResource Panama.Icon.Arrow.Up}"
                Command="{Binding Versions.Commands[VersionMoveUp]}"
                ToolTip="{x:Static r:ToolTip.MoveTitleVersionUp}"/>

            <Button
                Content="{StaticResource Panama.Icon.Arrow.Down}"
                Command="{Binding Versions.Commands[VersionMoveDown]}"
                ToolTip="{x:Static r:ToolTip.MoveTitleVersionDown}"/>

            <Button
                Content="{StaticResource Panama.Icon.Synchronize}"
                Command="{Binding Versions.Commands[VersionSync]}"
                ToolTip="{x:Static r:ToolTip.SynchonizeTitles}"/>

        </StackPanel>

        <tk:DataGrid
            Grid.Column="1"
            Style="{StaticResource Panama.Styles.DataGrid.Locked}"
            ItemsSource="{Binding Versions.ListView}"
            SelectedItem="{Binding Versions.SelectedItem}"
            tk:DataGridColumns.Columns="{Binding Versions.Columns}"
            ContextMenuOpeningCommand="{Binding Versions.Commands[ContextMenuOpening]}">

            <DataGrid.ContextMenu>
                <ContextMenu ItemsSource="{Binding Versions.MenuItems}"  />
            </DataGrid.ContextMenu>

            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding Versions.OpenRowCommand}"/>
            </DataGrid.InputBindings>

        </tk:DataGrid>

        <TextBlock
            Grid.Column="1"
            Style="{StaticResource Panama.Styles.TextBlock.ZeroResult}"
            tk:Property.IsCollapsed="{Binding Versions.HaveVersion}"
            Text="{x:Static r:Text.NoTitleVersions}"/>
    </Grid>

    <!-- Selected version note -->
    <StackPanel
        Grid.Row="1"
        tk:Property.IsNullCollapsed="{Binding Versions.SelectedVersion}">

        <TextBlock Text="Note"/>
        <TextBox Text="{Binding Versions.SelectedVersion.Note}"/>

    </StackPanel>

    <!-- Selected version internal properties Style="{StaticResource Panama.Styles.Panel.DataEntry}"-->
    <tk:NavigatorExpander
        Grid.Row="2"
        Header="Internal File Properties"
        Padding="{DynamicResource Panama.Layout.Padding.Vertical}"
        tk:Property.IsNullCollapsed="{Binding Versions.SelectedVersion}">

        <Grid tk:Property.RowHeights="Auto,*">
            <!-- Only displays when the selected version is Open Xml -->
            <Grid
                tk:Property.ColumnWidths="*,*"
                tk:Property.RowHeights="Auto,Auto,Auto"
                tk:Property.IsVisible="{Binding Versions.IsOpenXml}">

                <TextBlock Text="Created"/>
                <TextBlock Grid.Row="1">
                    <Run Style="{StaticResource Panama.Styles.Run.Highlight}" Text="{Binding Versions.Properties.Core.Created, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock Grid.Column="1" Text="Modified"/>
                <TextBlock Grid.Row="1" Grid.Column="1">
                    <Run Style="{StaticResource Panama.Styles.Run.Highlight}" Text="{Binding Versions.Properties.Core.Modified, Mode=OneWay}"/>
                </TextBlock>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                    <TextBlock Text="Title"/>
                    <TextBox Text="{Binding Versions.Properties.Core.Title}"/>

                    <TextBlock Text="Description / Comment"/>
                    <TextBox Text="{Binding Versions.Properties.Core.Description}"/>

                    <TextBlock Text="Subject"/>
                    <TextBox Text="{Binding Versions.Properties.Core.Subject}"/>

                    <TextBlock Text="Company"/>
                    <TextBox Text="{Binding Versions.Properties.Extended.Company}"/>

                    <Button
                        Content="Save"
                        Margin="{StaticResource Panama.Layout.Margin.Control.Stacked}"
                        Command="{Binding Versions.Commands[SaveProperty]}"/>

                    <TextBlock Text="{x:Static r:Detail.VersionProperties}"/>

                </StackPanel>
            </Grid>

             <!-- Only displays when the selected version is not Open Xml -->
            <TextBlock
                Grid.Row="1"
                Style="{StaticResource Panama.Styles.TextBlock.ZeroResult}"
                Text="{x:Static r:Text.NotOpenXmlDocument}"
                tk:Property.IsCollapsed="{Binding Versions.IsOpenXml}"/>
        </Grid>
    </tk:NavigatorExpander>

</Grid>