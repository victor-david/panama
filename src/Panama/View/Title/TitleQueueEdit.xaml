<StackPanel
    x:Class="Restless.Panama.View.TitleQueueEdit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:TitleQueueViewModel}"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="400"
    Style="{StaticResource App.Styles.Panel.DataEntry}">

    <!-- Date -->
    <TextBlock Text="{x:Static r:Text.Date}"/>
    <DatePicker SelectedDate="{Binding SelectedTitle.Date}"/>

    <!-- Clear date -->
    <Button
        Margin="{DynamicResource App.Layout.Margin.Control.Stacked}"
        Command="{Binding ClearDateCommand}"
        Content="{x:Static r:Text.ClearDate}"/>

    <!-- Status -->
    <TextBlock Text="{x:Static r:Text.Status}"/>
    <ListBox
        BorderThickness="1"
        ItemsSource="{Binding TitleStatus}"
        SelectedValue="{Binding SelectedTitle.Status}"
        SelectedValuePath="id"
        DisplayMemberPath="name"/>

</StackPanel>