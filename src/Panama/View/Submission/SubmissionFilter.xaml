<Grid
    x:Class="Restless.Panama.View.SubmissionFilter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:SubmissionViewModel}"
    mc:Ignorable="d"
    Style="{StaticResource App.Styles.Panel.DataEntry}"
    tk:Property.ColumnWidths="*,*,*"
    tk:Property.RowHeights="Auto,Auto,Auto,*"
    d:DesignHeight="450" d:DesignWidth="592">

    <!-- Title -->
    <StackPanel Grid.ColumnSpan="3" Margin="{StaticResource App.Layout.Margin.Control.Stacked.Right}">
        <TextBlock Text="{x:Static r:Text.Publisher}"/>
        <TextBox
            Text="{Binding Filters.Text,
            UpdateSourceTrigger=PropertyChanged,
            Delay=500}"/>
    </StackPanel>

</Grid>