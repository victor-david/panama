<Grid
    x:Class="Restless.Panama.View.SubmissionEditMessage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:SubmissionViewModel}"
    mc:Ignorable="d"
    tk:Property.RowHeights="*,2*"
    d:DesignHeight="600" d:DesignWidth="400">

    <tk:DataGrid
        Style="{StaticResource App.Styles.DataGrid.Locked}"
        Margin="{DynamicResource Panama.Layout.Margin.Control.Stacked}"
        ItemsSource="{Binding Messages.ListView}"
        SelectedItem="{Binding Messages.SelectedItem}"
        tk:DataGridColumns.Columns="{Binding Messages.Columns}">

        <DataGrid.InputBindings>
            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding Messages.OpenRowCommand}"/>
        </DataGrid.InputBindings>

        <DataGrid.ContextMenu>
            <ContextMenu ItemsSource="{Binding Messages.MenuItems}"/>
        </DataGrid.ContextMenu>

    </tk:DataGrid>

    <Grid
        Grid.Row="1"
        Style="{StaticResource App.Styles.Panel.DataEntry}"
        tk:Property.RowHeights="Auto,Auto,*"
        Visibility="{Binding Messages.EditVisibility}">

        <Grid.Resources>
            <Style TargetType="tk:LineItem" BasedOn="{StaticResource App.Styles.LineItem}">
                <Setter Property="Margin" Value="{DynamicResource Panama.Layout.Margin.Control.Stacked}"/>
            </Style>
        </Grid.Resources>

        <StackPanel>
            <TextBlock Text="{x:Static r:Text.Subject}"/>
            <TextBox Text="{Binding Messages.SelectedMessage.Display}"/>

            <tk:LineItem Item="{x:Static r:Header.Subject}" Value="{Binding Messages.SelectedMessage.Subject}"/>
            <tk:LineItem Item="{x:Static r:Header.Date}" Value="{Binding Messages.SelectedMessage.MessageDate}"/>
            <tk:LineItem Item="{x:Static r:Header.From}" Value="{Binding Messages.SelectedMessage.SenderName}"/>
            <tk:LineItem Item="{x:Static r:Header.To}" Value="{Binding Messages.SelectedMessage.RecipientName}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{x:Static r:Text.Message}"/>
        <TextBox
            Grid.Row="2"
            Style="{StaticResource App.Styles.TextBox.Multiline}"
            IsReadOnly="True"
            Text="{Binding Messages.MessageText, Mode=OneWay}"/>
    </Grid>
</Grid>