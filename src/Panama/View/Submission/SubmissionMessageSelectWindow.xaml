<mah:MetroWindow
    x:Class="Restless.Panama.View.SubmissionMessageSelectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:SubmissionMessageSelectWindowViewModel}"
    mc:Ignorable="d"
    Style="{StaticResource App.Styles.MetroWindow}"
    Title="{x:Static r:Header.SelectMessagesGeneric}"
    Height="460" Width="780">

    <Grid tk:Property.RowHeights="Auto,*,Auto">

        <!-- Filter options -->
        <tk:RadioButtonPanel
            Margin="{StaticResource Panama.Layout.Padding.Vertical}"
            tk:Property.ColumnWidths="Auto,Auto,Auto,Auto,Auto,Auto"
            SelectedValue="{Binding SelectedFilterValue}">

            <tk:RadioButton Grid.Column="0" Value="1" Content="{x:Static r:Text.Unassigned}"/>
            <tk:RadioButton Grid.Column="1" Value="7" Content="{x:Static r:Text.Days07}"/>
            <tk:RadioButton Grid.Column="2" Value="14" Content="{x:Static r:Text.Days14}"/>
            <tk:RadioButton Grid.Column="3" Value="21" Content="{x:Static r:Text.Days21}"/>
            <tk:RadioButton Grid.Column="4" Value="30" Content="{x:Static r:Text.Days30}"/>
            <tk:RadioButton Grid.Column="5" Value="0" Content="{x:Static r:Text.All}"/>

        </tk:RadioButtonPanel>

        <tk:DataGrid
            Grid.Row="1"
            BorderThickness="0,1,0,1"
            SelectionMode="Extended"
            SelectedItemsList="{Binding SelectedItems, Mode=OneWayToSource}"
            ItemsSource="{Binding ListView}"
            SelectedItem="{Binding SelectedItem}"
            tk:DataGridColumns.Columns="{Binding Columns}">
        </tk:DataGrid>

        <Button
            Grid.Row="2"
            Style="{StaticResource App.Styles.Button.Dialog}"
            Content="{x:Static r:Text.Okay}"
            Command="{Binding Commands[Select]}"/>

    </Grid>
</mah:MetroWindow>