<UserControl
    x:Class="Restless.Panama.View.PublishedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    d:DataContext="{d:DesignInstance Type=vm:PublishedViewModel}"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">

    <tk:SplitterGrid>

        <tk:SplitterGrid.HeaderLeft>
            <StatusBar>
                <TextBlock Text="{x:Static r:Header.Published}"/>
                <Separator/>
                <TextBlock Text="{x:Static r:Header.GroupBy}"/>
                <CheckBox IsChecked="{Binding GroupByNone}" Content="{x:Static r:Header.None}"/>
                <CheckBox IsChecked="{Binding GroupByType}" Content="{x:Static r:Header.Type}"/>
                <CheckBox IsChecked="{Binding GroupByTitle}" Content="{x:Static r:Header.Title}"/>
                <CheckBox IsChecked="{Binding GroupByPublisher}" Content="{x:Static r:Header.Publisher}"/>
                <Separator/>
                <CheckBox IsChecked="{Binding ActiveOnly}" Content="{x:Static r:Header.ActiveOnly}"/>
                <Separator/>
                <TextBlock Text="{x:Static r:Header.TitlePublisher}"/>
                <TextBox
                    Style="{StaticResource MahApps.Styles.TextBox.Button}"
                    mah:TextBoxHelper.ButtonCommand="{Binding ClearFilterCommand}"
                    Width="180" Text="{Binding SearchText, Delay=500, UpdateSourceTrigger=PropertyChanged}"/>

            </StatusBar>
        </tk:SplitterGrid.HeaderLeft>

        <tk:SplitterGrid.HeaderRight>
            <StatusBar>
                <TextBlock Text="{Binding SelectedPublished.Display}"/>
            </StatusBar>
        </tk:SplitterGrid.HeaderRight>

        <tk:SplitterGrid.ContentLeft>
            <tk:DataGrid
                CanUserReorderColumns="True"
                HeaderMode="ColumnSelector"
                ColumnSelectorMinimumVisible="3"
                ItemsSource="{Binding ListView}"
                SelectedItem="{Binding SelectedItem}"
                RestoreStateBehavior="RestoreLastSelection"
                tk:DataGridColumns.Columns="{Binding Columns}">

                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenRowCommand}"/>
                </DataGrid.InputBindings>

                <DataGrid.ContextMenu>
                    <ContextMenu ItemsSource="{Binding MenuItems}"/>
                </DataGrid.ContextMenu>

            </tk:DataGrid>

        </tk:SplitterGrid.ContentLeft>

        <tk:SplitterGrid.ContentRight>
            <Grid
                tk:Property.RowHeights="Auto,Auto,Auto,Auto,Auto,*,*"
                Style="{StaticResource App.Styles.Panel.DataEntry}"
                Visibility="{Binding EditVisibility}">

                <TextBlock Grid.Row="0" Text="{x:Static r:Text.Published}"/>

                <Grid Grid.Row="1" tk:Property.ColumnWidths="*,Auto" Margin="{StaticResource App.Layout.Margin.Control.Stacked}">
                    <DatePicker
                        Grid.Column="0"
                        Margin="{StaticResource App.Layout.Margin.Control.Stacked.Right}"
                        SelectedDate="{Binding SelectedPublished.Published}"/>
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource MahApps.Styles.Button.Flat}"
                        Command="{Binding ClearPublishedDateCommand}"
                        Content="{StaticResource App.Icon.Close}"
                        ToolTip="{x:Static r:ToolTip.ClearPublishedDate}"/>
                </Grid>

                <TextBlock Grid.Row="2" Text="{x:Static r:Text.Url}"/>
                <TextBox Grid.Row="3" Text="{Binding SelectedPublished.Url}"/>
                <TextBlock Grid.Row="4" Text="{x:Static r:Text.Notes}"/>
                <TextBox
                    Grid.Row="5"
                    Style="{StaticResource App.Styles.TextBox.Multiline}"
                    Text="{Binding SelectedPublished.Note}"/>

                <CheckBox
                    Grid.Row="6"
                    VerticalAlignment="Top"
                    Content="{x:Static r:Text.Active}"
                    IsChecked="{Binding SelectedPublished.Active}"/>

            </Grid>
        </tk:SplitterGrid.ContentRight>

    </tk:SplitterGrid>

</UserControl>