<UserControl
    x:Class="Restless.Panama.View.SettingsLanguage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:SettingsWindowViewModel}"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">

    <Grid tk:Property.RowHeights="*,Auto">
        <ListBox
            BorderThickness="1"
            ItemsSource="{Binding Languages}"
            SelectedItem="{Binding SelectedLanguage}"/>

        <Border
            Grid.Row="1"
            Background="{DynamicResource MahApps.Brushes.Accent3}"
            Padding="{StaticResource App.Layout.Padding.Full}"
            tk:Property.IsVisible="{Binding IsLanguageChangePending}">

            <!-- Override margin from DataEntry style -->
            <TextBlock Margin="0" Text="{x:Static r:Text.LanguageChangeRequested}"/>

        </Border>
    </Grid>
</UserControl>