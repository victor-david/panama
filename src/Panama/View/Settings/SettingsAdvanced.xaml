<UserControl
    x:Class="Restless.Panama.View.SettingsAdvanced"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:con="clr-namespace:Restless.Panama.Controls;assembly=Panama.Controls"
    xmlns:table="clr-namespace:Restless.Panama.Database.Tables;assembly=Panama.Database"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:SettingsWindowViewModel}"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">

    <StackPanel>
        <CheckBox Content="{x:Static r:Strings.SettingsQueue}" IsChecked="{Binding Config.IsTitleQueueVisible}"/>
        <CheckBox Content="{x:Static r:Strings.SettingsAutoSortOnUpdated}" IsChecked="{Binding Config.AutoSortOnTitleUpdated}"/>
        <CheckBox Content="{x:Static r:Strings.SettingsOrphanFinder}" IsChecked="{Binding Config.IsOrphanEnabled}"/>
        <CheckBox Content="{x:Static r:Strings.SettingsSearch}" IsChecked="{Binding Config.IsSearchEnabled}"/>
        <CheckBox Content="{x:Static r:Strings.SettingsVerifyLinks}" IsChecked="{Binding Config.IsVerifyLinkEnabled}"/>
        <CheckBox Content="{x:Static r:Strings.SettingsDeveloperTool}" IsChecked="{Binding Config.IsDevToolEnabled}"/>

        <con:PathSelector
            Title="{x:Static r:Strings.SettingsTextViewer}"
            SelectorType="File"
            SelectorFileType="{x:Static table:DocumentTypeTable+Defs+Values.ExecutableFileType}"
            Path="{Binding Config.TextViewerFile}"
            SelectCommand="{Binding Commands[SelectPath]}"/>

        <con:PathSelector
            Title="{x:Static r:Strings.SettingsDatabaseLocation}"
            Path="{Binding DatabaseLocation}"
            SelectCommand="{Binding Commands[SelectPath]}"/>

        <TextBlock Text="{x:Static r:Strings.SettingsDatabaseLocationText}"/>
    </StackPanel>

</UserControl>