<StackPanel
    x:Class="Restless.Panama.View.SettingsDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:core="clr-namespace:Restless.Panama.Core"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:vm="clr-namespace:Restless.Panama.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:SettingsWindowViewModel}"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">

    <StackPanel.Resources>
        <Style TargetType="tk:RadioButton">
            <Setter Property="Width" Value="48"/>
        </Style>
    </StackPanel.Resources>

    <TextBlock Text="{x:Static r:Settings.DataGridRowHeight}"/>
    <Slider
        Minimum="{x:Static core:Config+DataGrid.MinRowHeight}"
        Maximum="{x:Static core:Config+DataGrid.MaxRowHeight}"
        Value="{Binding Config.DataGridRowHeight}"/>

    <TextBlock Text="{x:Static r:Settings.DataGridRowAlternation}"/>

    <tk:RadioButtonPanel
        TemplateStyle="Button"
        Margin="{StaticResource Panama.Layout.Padding.Bottom}"
        tk:Property.ColumnWidths="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
        SelectedValue="{Binding Config.DataGridAlternationCount}">

        <tk:RadioButton Grid.Column="0" Value="10" Content="Off"/>
        <tk:RadioButton Grid.Column="1" Value="2" Content="2"/>
        <tk:RadioButton Grid.Column="2" Value="3" Content="3"/>
        <tk:RadioButton Grid.Column="3" Value="4" Content="4"/>
        <tk:RadioButton Grid.Column="4" Value="5" Content="5"/>
        <tk:RadioButton Grid.Column="5" Value="6" Content="6"/>
        <tk:RadioButton Grid.Column="6" Value="7" Content="7"/>
        <tk:RadioButton Grid.Column="7" Value="8" Content="8"/>
    </tk:RadioButtonPanel>

    <TextBlock Text="{x:Static r:Settings.NavigatorHeader}"/>

    <ListBox
        Style="{StaticResource Panama.Styles.ListBox.Radio}"
        ItemsSource="{Binding NavigatorHeaders}"
        SelectedItem="{Binding Config.NavigatorHeader}"/>

</StackPanel>