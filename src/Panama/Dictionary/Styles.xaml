<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="http://schemas.restless.toolkit.com/2021"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:core="clr-namespace:Restless.Panama.Core"
    xmlns:r="clr-namespace:Restless.Panama.Resources;assembly=Panama.Resources"
    xmlns:con="clr-namespace:Restless.Panama.Controls;assembly=Panama.Controls">

    <!-- Window -->
    <Style x:Key="Panama.Styles.MetroWindow" TargetType="mah:MetroWindow">
        <Setter Property="TitleAlignment" Value="Center"/>
        <Setter Property="TitleCharacterCasing" Value="Normal"/>
        <Setter Property="TitleBarHeight" Value="{DynamicResource Panama.Layout.TitleBar.Height}"/>
        <Setter Property="IconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <ico:PackIconPhosphorIcons
                        Kind="Notebook"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="4"
                        Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window buttons (min, max, close) -->
    <Style x:Key="Panama.Styles.Button.Window.Light" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.MetroWindow.Light}">
        <Setter Property="MaxHeight" Value="42"/>
    </Style>

    <Style x:Key="Panama.Styles.Button.Window.Dark" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.MetroWindow.Dark}">
        <Setter Property="MaxHeight" Value="42"/>
    </Style>

    <Style TargetType="mah:WindowButtonCommands">
        <Setter Property="DarkCloseButtonStyle" Value="{StaticResource Panama.Styles.Button.Window.Dark}"/>
        <Setter Property="DarkMaxButtonStyle" Value="{StaticResource Panama.Styles.Button.Window.Dark}"/>
        <Setter Property="DarkMinButtonStyle" Value="{StaticResource Panama.Styles.Button.Window.Dark}"/>
        <Setter Property="LightCloseButtonStyle" Value="{StaticResource Panama.Styles.Button.Window.Light}"/>
        <Setter Property="LightMaxButtonStyle" Value="{StaticResource Panama.Styles.Button.Window.Light}"/>
        <Setter Property="LightMinButtonStyle" Value="{StaticResource Panama.Styles.Button.Window.Light}"/>
    </Style>

    <!-- tk:MessageWindow (used for dialogs) -->
    <Style TargetType="tk:MessageWindow">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.WindowTitle}"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForegound}"/>
        <Setter Property="TitleBarButtonBrush" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
        <Setter Property="TitleBarBackground" Value="{DynamicResource MahApps.Brushes.WindowTitle}"/>
        <Setter Property="TitleBarForeground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
        <Setter Property="ButtonStyle">
            <Setter.Value>
                <Style TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
                    <Setter Property="Margin" Value="4,2"/>
                    <Setter Property="MinWidth" Value="92"/>
                    <Setter Property="Padding" Value="2"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main splitter -->
    <Style x:Key="Panama.Styles.MainSplitter" TargetType="tk:MultiSplitterGrid">
        <Setter Property="CanCollapseDetail" Value="False"/>
        <Setter Property="DetailContentMargin" Value="0"/>
        <Setter Property="DetailHeaderMargin" Value="0"/>
        <Setter Property="MainContentMargin" Value="{DynamicResource Panama.Layout.Padding.Full}"/>
        <Setter Property="MainHeaderMargin" Value="0"/>
        <Setter Property="SplitterPosition" Value="Left"/>
    </Style>

    <!-- Splitter Grid-->
    <Style x:Key="Panama.Styles.SplitterGrid" TargetType="tk:SplitterGrid">
        <Setter Property="MarginContentLeft" Value="{DynamicResource Panama.Layout.Padding.Top.Right.Bottom}"/>
        <Setter Property="MarginContentRight" Value="{DynamicResource Panama.Layout.Padding.Full}"/>
        <Setter Property="MarginHeaderLeft" Value="0,0,2,0"/>
        <Setter Property="MarginHeaderRight" Value="2,0,0,0"/>
    </Style>

    <Style TargetType="tk:SplitterGrid" BasedOn="{StaticResource Panama.Styles.SplitterGrid}" />

    <!-- Toggle button for tk:SplitterGrid -->
    <Style
        x:Key="{x:Static tk:ResourceKeys.SplitterGridToggleButtonStyleKey}"
        TargetType="ToggleButton"
        BasedOn="{StaticResource {x:Static tk:ResourceKeys.SplitterGridToggleButtonStyleKey}}">

        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
    </Style>

    <!-- Icons -->
    <Style x:Key="Panama.Styles.Icon" TargetType="ico:PackIconMaterial">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ico:PackIconMaterial" BasedOn="{StaticResource Panama.Styles.Icon}"/>

    <Style x:Key="Panama.Styles.Icon.TitleBar" TargetType="ico:PackIconMaterial" BasedOn="{StaticResource Panama.Styles.Icon}">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
    </Style>

    <!-- Named icons (see ResourceKeys also, names must correspond ) -->
    <ico:Material x:Key="Panama.Icon.Alert" x:Shared="False"  Kind="AlertBoxOutline"/>
    <ico:Material x:Key="Panama.Icon.Arrow.Down" x:Shared="False"  Kind="ArrowDownBold"/>
    <ico:Material x:Key="Panama.Icon.Arrow.Up" x:Shared="False"  Kind="ArrowUpBold"/>
    <ico:Material x:Key="Panama.Icon.Calendar" x:Shared="False"  Kind="CalendarOutline"/>
    <ico:Material x:Key="Panama.Icon.Calendar.Clear" x:Shared="False"  Kind="CalendarMinusOutline"/>
    <ico:Material x:Key="Panama.Icon.Check" x:Shared="False"  Kind="CheckBold"/>
    <ico:Material x:Key="Panama.Icon.Chevron.Down" x:Shared="False"  Kind="ChevronDown"/>
    <ico:Material x:Key="Panama.Icon.Chevron.Left" x:Shared="False"  Kind="ChevronLeft"/>
    <ico:Material x:Key="Panama.Icon.Chevron.Right" x:Shared="False"  Kind="ChevronRight"/>
    <ico:Material x:Key="Panama.Icon.Chevron.Up" x:Shared="False"  Kind="ChevronUp"/>
    <ico:Material x:Key="Panama.Icon.Close" x:Shared="False"  Kind="CloseThick"/>
    <ico:Material x:Key="Panama.Icon.Copy" x:Shared="False"  Kind="ContentCopy"/>
    <ico:Material x:Key="Panama.Icon.Delete" x:Shared="False"  Kind="TrashCanOutline"/>
    <ico:Material x:Key="Panama.Icon.File" x:Shared="False"  Kind="FileDocumentOutline"/>
    <ico:Material x:Key="Panama.Icon.File.Extension" x:Shared="False"  Kind="FileDocumentArrowRightOutline"/>
    <ico:Material x:Key="Panama.Icon.File.Replace" x:Shared="False"  Kind="FileReplaceOutline"/>
    <ico:Material x:Key="Panama.Icon.Filter" x:Shared="False"  Kind="FilterOutline"/>
    <ico:Material x:Key="Panama.Icon.Filter.Off" x:Shared="False"  Kind="FilterOffOutline"/>
    <ico:Material x:Key="Panama.Icon.Folder" x:Shared="False"  Kind="FolderOutline"/>
    <ico:Material x:Key="Panama.Icon.Minus" x:Shared="False"  Kind="Minus"/>
    <ico:Material x:Key="Panama.Icon.Plus" x:Shared="False"  Kind="Plus"/>
    <ico:Material x:Key="Panama.Icon.Remove" x:Shared="False"  Kind="SelectionRemove"/>
    <ico:Material x:Key="Panama.Icon.Square" x:Shared="False"  Kind="Square"/>
    <ico:Material x:Key="Panama.Icon.Synchronize" x:Shared="False"  Kind="ArrowURightTopBold"/>
    <ico:Material x:Key="Panama.Icon.Toggle" x:Shared="False"  Kind="ToggleSwitchOutline"/>
    <ico:Material x:Key="Panama.Icon.Tray.Full" x:Shared="False"  Kind="TrayFull"/>
    <ico:Material x:Key="Panama.Icon.Tray.Plus" x:Shared="False"  Kind="TrayPlus"/>
    <ico:Material x:Key="Panama.Icon.Tray.Remove" x:Shared="False"  Kind="TrayRemove"/>

    <!-- Buttons -->
    <Style x:Key="Panama.Styles.Button.Dialog" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
        <Setter Property="Margin" Value="3"/>
        <Setter Property="MinWidth" Value="128"/>
    </Style>

    <Style x:Key="Panama.Styles.Button.StatusBar" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,1,0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">

                        <ContentPresenter
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Panama.Styles.Button.Bordered.Accent" TargetType="Button" BasedOn="{StaticResource Panama.Styles.Button.StatusBar}">
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Main navigator-->
    <Style TargetType="tk:MainNavigator">
        <Setter Property="Margin" Value="10,0,0,10"/>
        <Setter Property="ItemIndent" Value="25"/>
        <Setter Property="HideWhenEmpty" Value="False"/>
        <Style.Resources>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MahApps.Styles.ListBoxItem}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
        </Style.Resources>
    </Style>

    <!-- Navigator expander -->
    <Style x:Key="Panama.Styles.NavigatorExpander" TargetType="tk:NavigatorExpander" BasedOn="{StaticResource {x:Static tk:ResourceKeys.DefaultNavigatorExpanderStyleKey}}">
        <Setter Property="Icon" Value="{DynamicResource Panama.Icon.Chevron.Right}"/>
        <Setter Property="ExpandedIcon" Value="{DynamicResource Panama.Icon.Chevron.Down}"/>
        <Setter Property="Padding" Value="0,2,0,0"/>
    </Style>

    <Style TargetType="tk:NavigatorExpander" BasedOn="{StaticResource Panama.Styles.NavigatorExpander}"/>

    <!-- Path selector -->
    <Style x:Key="{x:Static con:PathSelector.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Flat}">
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Padding" Value="4,0"/>
    </Style>

    <Style x:Key="Panana.Styles.PathSelector" TargetType="con:PathSelector">
        <Setter Property="ButtonContent" Value="{DynamicResource Panama.Icon.Chevron.Right}"/>
    </Style>

    <Style TargetType="con:PathSelector" BasedOn="{StaticResource Panana.Styles.PathSelector}"/>

    <!-- Titled Separator-->
    <Style x:Key="Panama.Styles.TitledSeparator" TargetType="con:TitledSeparator">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray7}"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Margin" Value="{DynamicResource Panama.Layout.Margin.Control.Stacked}"/>
        <Setter Property="SeparatorHeight" Value="2"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="con:TitledSeparator" BasedOn="{StaticResource Panama.Styles.TitledSeparator}"/>

    <!-- Month/Day selector -->
    <Style x:Key="Panama.Styles.MonthDaySelector" TargetType="con:MonthDaySelector">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
        <Setter Property="SelectedBackgroundBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="SelectedForegroundBrush" Value="{DynamicResource MahApps.Brushes.Selected.Foreground}"/>
    </Style>

    <Style TargetType="con:MonthDaySelector" BasedOn="{StaticResource Panama.Styles.MonthDaySelector}"/>

    <!-- Flyout -->
    <Style x:Key="Panama.Styles.Flyout" TargetType="con:Flyout">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="Padding" Value="{DynamicResource Panama.Layout.Padding.Full}"/>
        <Setter Property="Placement" Value="TopRight"/>
    </Style>

    <Style TargetType="con:Flyout" BasedOn="{StaticResource Panama.Styles.Flyout}"/>

    <!-- Data grid-->
    <Style x:Key="Panama.Styles.DataGridRow" TargetType="DataGridRow">
        <Style.Triggers>
            <!-- IsSelected -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.DataGrid.Selection.Background}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.DataGrid.Selection.BorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.DataGrid.Selection.Text}" />
            </Trigger>
            <!--  IsSelected and !Selector.IsSelectionActive -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.DataGrid.Selection.Background.Inactive}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.DataGrid.Selection.BorderBrush.Inactive}" />
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.DataGrid.Selection.Text.Inactive}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- External keys -->
    <!-- These are transparent, otherwise the triggers (above) don't have an effect -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#00000000"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#00000000"/>

    <Style x:Key="Panama.Styles.DataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Static tk:ResourceKeys.DefaultDataGridStyleKey}}">
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource MahApps.Brushes.Accent4}"/>
        <Setter Property="AlternationCount" Value="{Binding Config.DataGridAlternationCount}"/>
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
        <Setter Property="MinRowHeight" Value="28"/>
        <Setter Property="RowHeight" Value="{Binding Config.DataGridRowHeight}"/>
        <Setter Property="RowStyle" Value="{StaticResource Panama.Styles.DataGridRow}"/>
        <Style.Triggers>
            <Trigger Property="AlternationCount" Value="10">
                <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
        <Style.Resources>
            <!-- Prevent another text block style from falling into the list box -->
            <Style TargetType="TextBlock"/>
        </Style.Resources>
    </Style>

    <Style TargetType="DataGrid" BasedOn="{StaticResource Panama.Styles.DataGrid}"/>
    <Style TargetType="tk:DataGrid" BasedOn="{StaticResource Panama.Styles.DataGrid}"/>

    <Style x:Key="Panama.Styles.DataGrid.Locked" TargetType="DataGrid" BasedOn="{StaticResource Panama.Styles.DataGrid}">
        <Setter Property="CanUserSortColumns" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="RowHeight" Value="{x:Static core:Config+DataGrid.MinRowHeight}"/>
    </Style>

    <!-- Display grid (used in statistics) -->
    <Style x:Key="Panama.Styles.DisplayGrid" TargetType="con:DisplayGrid">
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HeaderFontSize" Value="13"/>
        <Setter Property="HeaderForeground" Value="{DynamicResource MahApps.Brushes.WindowTitle}"/>
        <Setter Property="ValueFontSize" Value="12"/>
        <Setter Property="ValueForeground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
        <Setter Property="ValueHorizontalAlignment" Value="Right"/>
    </Style>

    <Style TargetType="con:DisplayGrid" BasedOn="{StaticResource Panama.Styles.DisplayGrid}"/>

    <!-- List box -->
    <Style x:Key="Panama.Styles.ListBox" TargetType="ListBox" BasedOn="{StaticResource MahApps.Styles.ListBox}">
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.TextBox.Border}"/>
    </Style>

    <Style TargetType="ListBox" BasedOn="{StaticResource Panama.Styles.ListBox}"/>

    <!-- List box (navigator) -->
    <Style x:Key="Panama.Styles.ListBox.Navigator" TargetType="ListBox" BasedOn="{StaticResource Panama.Styles.ListBox}">
        <Style.Resources>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MahApps.Styles.ListBoxItem}">
                <Setter Property="MinHeight" Value="0"/>
            </Style>
        </Style.Resources>
    </Style>

    <!-- List box (radio choices) -->
    <Style x:Key="Panama.Styles.ListBox.Radio" TargetType="ListBox" BasedOn="{StaticResource Panama.Styles.ListBox}">
        <Setter Property="Padding" Value="6,0"/>

        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <RadioButton
                        GroupName="props.e59c9231"
                        Content="{Binding}"
                        Margin="0,3"
                        IsChecked="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
            </Style>
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.60"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Slider -->
    <Style x:Key="Panama.Styles.Slider" TargetType="Slider" BasedOn="{StaticResource MahApps.Styles.Slider}">
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
    </Style>

    <Style TargetType="Slider" BasedOn="{StaticResource Panama.Styles.Slider}"/>

    <!-- DatePicker -->
    <Style x:Key="Panama.Styles.DatePicker" TargetType="DatePicker" BasedOn="{StaticResource MahApps.Styles.DatePicker}">
        <Setter Property="SelectedDateFormat" Value="Long"/>
    </Style>

    <Style TargetType="DatePicker" BasedOn="{StaticResource Panama.Styles.DatePicker}"/>

    <Style x:Key="Panama.Styles.DatePickerTextBox" TargetType="DatePickerTextBox" BasedOn="{StaticResource MahApps.Styles.DatePickerTextBox}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
    </Style>

    <Style TargetType="DatePickerTextBox" BasedOn="{StaticResource Panama.Styles.DatePickerTextBox}"/>

    <!-- Data panel -->
    <Style x:Key="Panama.Styles.TextBlock.DataEntry" TargetType="TextBlock">
        <Setter Property="Margin" Value="{StaticResource Panama.Layout.Margin.DataEntry}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Panama.Styles.Panel.DataEntry" TargetType="Panel">
        <Style.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Panama.Styles.TextBlock.DataEntry}"/>

            <Style TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
                <Setter Property="Margin" Value="{StaticResource Panama.Layout.Margin.DataEntry}"/>
            </Style>

            <Style TargetType="CheckBox" BasedOn="{StaticResource MahApps.Styles.CheckBox}">
                <Setter Property="Margin" Value="{StaticResource Panama.Layout.Margin.DataEntry}"/>
            </Style>

            <Style TargetType="ListBox" BasedOn="{StaticResource Panama.Styles.ListBox}">
                <Setter Property="Margin" Value="{StaticResource Panama.Layout.Margin.DataEntry}"/>
                <Style.Resources>
                    <!-- Prevent the text block style from falling into the list box -->
                    <Style TargetType="TextBlock"/>
                </Style.Resources>
            </Style>

            <Style x:Key="{x:Static con:PathSelector.TextBlockStyleKey}" TargetType="TextBlock" BasedOn="{StaticResource Panama.Styles.TextBlock.DataEntry}"/>

            <Style TargetType="con:PathSelector" BasedOn="{StaticResource Panana.Styles.PathSelector}">
                <Setter Property="Margin" Value="{StaticResource Panama.Layout.Margin.DataEntry}"/>
            </Style>

            <Style TargetType="DatePicker" BasedOn="{StaticResource Panama.Styles.DatePicker}">
                <Setter Property="Margin" Value="{StaticResource Panama.Layout.Margin.DataEntry}"/>
            </Style>

            <Style TargetType="Slider" BasedOn="{StaticResource Panama.Styles.Slider}">
                <Setter Property="Margin" Value="{StaticResource Panama.Layout.Margin.DataEntry}"/>
            </Style>

            <Style TargetType="tk:NavigatorExpander" BasedOn="{StaticResource Panama.Styles.NavigatorExpander}">
                <Setter Property="Margin" Value="{StaticResource Panama.Layout.Margin.DataEntry}"/>
            </Style>
        </Style.Resources>
    </Style>

    <!-- StackPanel -->
    <Style x:Key="Panama.Styles.StackPanel.ToolBar.Vertical" TargetType="StackPanel">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}"/>
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Width" Value="38"/>
        <Style.Resources>
            <Style TargetType="Button" BasedOn="{StaticResource Panama.Styles.Button.Bordered.Accent}">
                <Setter Property="Height" Value="32"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
                <Setter Property="MinWidth" Value="32"/>
                <Setter Property="Width" Value="32"/>
            </Style>
        </Style.Resources>
    </Style>

    <!-- TextBlock: Main Title -->
    <Style x:Key="Panama.Styles.TextBlock.NavTitle" TargetType="TextBlock">
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- TextBlock: Notification message -->
    <Style x:Key="Panama.Styles.TextBlock.NotificationMessage" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                            <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:5" Value="1"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:7.5" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <ThicknessAnimation From="180,0" To="0" Duration="0:0:1" Storyboard.TargetProperty="Margin">
                            <ThicknessAnimation.EasingFunction>
                                <BounceEase Bounces="10" Bounciness="1.5"/>
                            </ThicknessAnimation.EasingFunction>
                        </ThicknessAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- TextBlock: Accent -->
    <Style x:Key="Panama.Styles.TextBlock.Accent" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
    </Style>

    <!-- TextBlock: Highlight -->
    <Style x:Key="Panama.Styles.TextBlock.Highlight" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
    </Style>

    <!-- TextBlock: Zero result -->
    <Style x:Key="Panama.Styles.TextBlock.ZeroResult" TargetType="TextBlock" BasedOn="{StaticResource Panama.Styles.TextBlock.Highlight}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- TextBlock: Error-->
    <Style x:Key="Panama.Styles.TextBlock.Error" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Run-->
    <Style x:Key="Panama.Styles.Run.Highlight" TargetType="Run">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
    </Style>

    <!-- TextBox -->
    <Style x:Key="Panama.Styles.TextBox.Multiline" TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- StatusBar-->
    <Style x:Key="Panama.Styles.StatusBar" TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}"/>
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.StatusBar}"/>
        <Setter Property="Padding" Value="3"/>
        <Style.Resources>
            <Style TargetType="Button" BasedOn="{StaticResource Panama.Styles.Button.StatusBar}"/>
        </Style.Resources>
    </Style>

    <Style TargetType="StatusBar" BasedOn="{StaticResource Panama.Styles.StatusBar}"/>

    <Style x:Key="Panama.Styles.StatusBar.Selector" TargetType="StatusBar" BasedOn="{StaticResource Panama.Styles.StatusBar}">
        <Style.Resources>
            <Style TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
                <Setter Property="Margin" Value="2"/>
                <Setter Property="MinWidth" Value="82"/>
                <Setter Property="Padding" Value="2"/>
            </Style>
        </Style.Resources>
    </Style>

    <!-- tk:RadioButtonPanel / tk:RadioButton -->
    <Style x:Key="Panama.Styles.RadioButtonPanel" TargetType="tk:RadioButtonPanel">
        <Setter Property="TemplateStyle" Value="Underline"/>
        <Setter Property="UnderlineHeight" Value="3"/>
    </Style>

    <Style x:Key="Panama.Styles.RadioButton" TargetType="tk:RadioButton">
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="Padding" Value="0,2"/>
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
    </Style>

    <Style TargetType="tk:RadioButtonPanel" BasedOn="{StaticResource Panama.Styles.RadioButtonPanel}"/>
    <Style TargetType="tk:RadioButton" BasedOn="{StaticResource Panama.Styles.RadioButton}"/>

    <!-- tk:ThreeWay -->
    <Style x:Key="Panama.Styles.ThreeWay" TargetType="tk:ThreeWay">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="SelectorHeight" Value="20"/>
        <Setter Property="SelectorRadius" Value="2"/>
        <Setter Property="MinSelectorAreaWidth" Value="120"/>
        <Setter Property="OnText" Value="{x:Static r:Text.Yes}"/>
        <Setter Property="OffText" Value="{x:Static r:Text.No}"/>
        <Setter Property="HeaderStyle">
            <Setter.Value>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Static tk:ThreeWay.HeaderStyleKey}}">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="OnOffStyle">
            <Setter.Value>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Static tk:ThreeWay.OnOffStyleKey}}">
                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="tk:ThreeWay" BasedOn="{StaticResource Panama.Styles.ThreeWay}"/>

    <!-- tk:LineItem -->
    <Style x:Key="Panama.Styles.LineItem" TargetType="tk:LineItem">
        <Setter Property="ItemDisplayWidth" Value="100"/>
        <Setter Property="ItemFontSize" Value="12"/>
        <Setter Property="IndentLevel" Value="0"/>
        <Setter Property="ValueFontSize" Value="11"/>
        <Setter Property="ItemVerticalAlignment" Value="Top"/>
        <Setter Property="ValueVerticalAlignment" Value="Top"/>
        <Setter Property="ItemForeground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="ValueForeground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
    </Style>

    <Style TargetType="tk:LineItem" BasedOn="{StaticResource Panama.Styles.LineItem}"/>

    <!-- tk:LinkedTextBlock -->
    <Style x:Key="Panama.Styles.LinkedTextBlock" TargetType="tk:LinkedTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="RolloverBrush" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
    </Style>

    <Style TargetType="tk:LinkedTextBlock" BasedOn="{StaticResource Panama.Styles.LinkedTextBlock}"/>

    <!-- Border -->
    <Style x:Key="Panama.Styles.Border.Container" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="{DynamicResource Panama.Layout.Padding.Full}"/>
    </Style>

    <!-- ToolTip -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="AliceBlue"/>
        <Setter Property="BorderBrush" Value="DarkGray"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>

    <Style x:Key="Panama.Styles.Panel.ToolTip" TargetType="Panel">
        <Style.Resources>
            <Style TargetType="StatusBar" BasedOn="{StaticResource Panama.Styles.StatusBar}">
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                <Setter Property="Margin" Value="-4,-2,-4,3"/>
                <Setter Property="Padding" Value="0"/>
                <Style.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Style>
                </Style.Resources>

            </Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="6,3"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Width" Value="12"/>
            </Style>

            <Style TargetType="ContentControl">
                <Setter Property="Margin" Value="6,3"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                <Setter Property="Margin" Value="6,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>

            </Style>
        </Style.Resources>
    </Style>

</ResourceDictionary>